# Copy to .env.local. All values are optional.
# SQLite file location, relative to backend/.
DATABASE_PATH=data/app.db
# Phone number shown to parents in WhatsApp messages.
CENTRE_PHONE=
# Path to the WhatsApp bot SQLite DB, read-only (relative to backend/).
BOT_DB_PATH=../bot/absences.sqlite

# Session video review. Recordings and generated clips stay on this computer.
# Copy the real key only into .env.local (which is gitignored).
OPENAI_API_KEY=
OPENAI_VIDEO_MODEL=gpt-6-luna
VIDEO_STORAGE_PATH=data/video-reviews
