# Copy to .env.local. All values are optional.
# SQLite file location, relative to backend/.
DATABASE_PATH=data/app.db
# Phone number shown to parents in WhatsApp messages.
CENTRE_PHONE=
# Path to the WhatsApp bot SQLite DB, read-only (relative to backend/).
BOT_DB_PATH=../bot/absences.sqlite

# Required only for the AI scheduling agent. Create a project API key at:
# https://platform.openai.com/api-keys
# Keep the real key in .env.local; never commit it.
OPENAI_API_KEY=

# Optional model used by the scheduling agent. Defaults to gpt-5-mini when omitted.
OPENAI_MODEL=gpt-5-mini
