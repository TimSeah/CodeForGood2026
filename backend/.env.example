# Copy this file to backend/.env. Never commit the real file or secrets.

# --- Core backend -------------------------------------------------------------
# SQLite file location, relative to backend/. The default works for local use.
DATABASE_PATH=data/app.db
# Optional phone number shown to parents in WhatsApp messages.
CENTRE_PHONE=
# Read-only path to the WhatsApp bot SQLite DB, relative to backend/.
BOT_DB_PATH=../bot/absences.sqlite
# Long random shared secret used only on the local bot/backend connection.
# Must match BOT_SHARED_SECRET in bot/.env.
BOT_SHARED_SECRET=

# --- OpenAI features ----------------------------------------------------------
# Required for AI-assisted scheduling and session video review. Create a project API key at:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI scheduling agent model.
OPENAI_MODEL=gpt-5-mini

# Session video review model and local storage path. Recordings and clips remain on this computer.
OPENAI_VIDEO_MODEL=gpt-6-luna
VIDEO_STORAGE_PATH=data/video-reviews
