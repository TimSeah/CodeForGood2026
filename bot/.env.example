# Required Meta WhatsApp Cloud API credentials.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Optional runtime settings (these example values can be overridden).
GRAPH_API_VERSION=v25.0
PORT=3000
DB_PATH=absences.sqlite

# Optional writable directory for the downloaded local OCR model.
# Defaults to node_modules/.cache/absence-bot.
OCR_CACHE_DIR=
WEBHOOK_URL=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_PATH=
# Local backend connection; set both values to enable notification delivery and parent replies.
BACKEND_URL=http://127.0.0.1:3001/
BOT_SHARED_SECRET=
# POC only: send standard text when the recipient messaged within 23.5 hours; no Meta template approval needed.
POC_SESSION_MESSAGES=false
