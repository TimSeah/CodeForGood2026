# Required Meta WhatsApp Cloud API credentials.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Optional runtime settings. These defaults are used when omitted.
GRAPH_API_VERSION=v23.0
PORT=3000
DB_PATH=absences.sqlite

# Optional writable directory for the downloaded local OCR model.
# Defaults to node_modules/.cache/absence-bot.
OCR_CACHE_DIR=
